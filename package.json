{
  "name": "marklet",
  "version": "0.1.4",
  "description": "Lightweight, open-source Markdown viewer. Reading first.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run && vitest run -c vitest.components.config.ts",
    "test:unit": "vitest run",
    "test:components": "vitest run -c vitest.components.config.ts",
    "test:watch": "vitest",
    "tauri": "tauri",
    "contrast": "node scripts/check-contrast.mjs",
    "check:imports": "node scripts/check-imports.mjs",
    "check:ipc": "node scripts/check-ipc-args.mjs",
    "check:print": "node scripts/check-print-chrome.mjs",
    "check:shortcuts": "node scripts/check-shortcuts.mjs",
    "size": "node scripts/size-report.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.3",
    "happy-dom": "^20.14.6",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@tauri-apps/api": "^2.12.4",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "mermaid": "^12.2.0"
  },
  "//": "mermaid/katex/highlight.js (P4) are reached only via import() from src/lib/rich/index.ts's enrich() — never from src/main.ts or any static import; npm run check:imports enforces it. Editor deps (@codemirror/*) land in P7 the same way. See .claude/skills/size-budget/SKILL.md. happy-dom is test-only (tests/unit/rich-enrich.test.ts's @vitest-environment override) and never ships."
}
